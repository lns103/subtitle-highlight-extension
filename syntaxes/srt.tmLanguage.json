{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SubRip",
  "scopeName": "source.subrip",
  "fileTypes": [
    "srt",
    "subrip"
  ],
  "patterns": [
    {
      "match": "^[ \\t]*([0-9]+)[ \\t]*$",
      "name": "entity.name.tag.index.subrip",
      "captures": {
        "1": {
          "name": "constant.numeric.index.subrip"
        }
      }
    },
    {
      "match": "^[ \\t]*(\\d{1,2}:[0-5][0-9]:[0-5][0-9][,.]\\d{3})[ \\t]+(-->)[ \\t]+(\\d{1,2}:[0-5][0-9]:[0-5][0-9][,.]\\d{3})([ \\t]+(X1:\\d+[ \\t]+X2:\\d+[ \\t]+Y1:\\d+[ \\t]+Y2:\\d+))?[ \\t]*$",
      "captures": {
        "1": {
          "name": "constant.other.timestamp.subrip"
        },
        "2": {
          "name": "constant.other.timestamp.subrip"
        },
        "3": {
          "name": "constant.other.timestamp.subrip"
        },
        "5": {
          "name": "constant.other.coordinates.subrip"
        }
      }
    },
    {
      "begin": "^[ \\t]*(?=\\S)",
      "end": "$",
      "name": "string.literal.subrip",
      "patterns": [
        {
          "match": "\\{\\\\?[a-zA-Z0-9]+\\}",
          "name": "constant.other.ass-tag.subrip"
        },
        {
          "match": "(?i)(</?)(b|i|u|font|s)([^>]*)(>)",
          "captures": {
            "1": {
              "name": "punctuation.definition.tag.begin.subrip"
            },
            "2": {
              "name": "entity.name.tag.subrip"
            },
            "3": {
              "name": "meta.attribute.subrip"
            },
            "4": {
              "name": "punctuation.definition.tag.end.subrip"
            }
          }
        }
      ]
    }
  ]
}

{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "WebVTT",
  "scopeName": "source.webvtt",
  "fileTypes": [
    "vtt"
  ],
  "patterns": [
    {
      "include": "#header"
    },
    {
      "include": "#comment"
    },
    {
      "include": "#cue"
    }
  ],
  "repository": {
    "header": {
      "patterns": [
        {
          "match": "^[ \\t]*(WEBVTT)([^\\r\\n]*)$",
          "name": "meta.header.webvtt",
          "captures": {
            "1": {
              "name": "keyword.control.header.webvtt"
            }
          }
        },
        {
          "match": "^[ \\t]*([A-Za-z][A-Za-z0-9_-]*)(:)([ \\t]*)(.*)$",
          "name": "meta.metadata.webvtt",
          "captures": {
            "1": {
              "name": "entity.name.tag.metadata.webvtt"
            },
            "2": {
              "name": "punctuation.separator.key-value.webvtt"
            },
            "4": {
              "name": "string.unquoted.metadata.webvtt"
            }
          }
        }
      ]
    },
    "comment": {
      "patterns": [
        {
          "begin": "^[ \\t]*(NOTE)\\b",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.comment.webvtt"
            }
          },
          "end": "(?=^[ \\t]*$)",
          "name": "comment.block.webvtt"
        }
      ]
    },
    "cue": {
      "patterns": [
        {
          "match": "^[ \\t]*(STYLE|REGION)[ \\t]*$",
          "name": "keyword.control.style.webvtt"
        },
        {
          "match": "^[ \\t]*([0-9]+)[ \\t]*$",
          "name": "entity.name.tag.index.webvtt",
          "captures": {
            "1": {
              "name": "constant.numeric.index.webvtt"
            }
          }
        },
        {
          "match": "^[ \\t]*((?:(?:[0-9]{1,2}):)?[0-9]{2}:[0-9]{2}\\.[0-9]{3})[ \\t]+(-->)[ \\t]+((?:(?:[0-9]{1,2}):)?[0-9]{2}:[0-9]{2}\\.[0-9]{3})([ \\t]+(.*?))?[ \\t]*$",
          "captures": {
            "1": {
              "name": "constant.other.timestamp.webvtt"
            },
            "2": {
              "name": "keyword.operator.assignment.webvtt"
            },
            "3": {
              "name": "constant.other.timestamp.webvtt"
            },
            "5": {
              "patterns": [
                {
                  "match": "([A-Za-z-]+)(:)([^ \\t\\r\\n]+)",
                  "captures": {
                    "1": {
                      "name": "entity.other.attribute-name.cue-setting.webvtt"
                    },
                    "2": {
                      "name": "punctuation.separator.key-value.webvtt"
                    },
                    "3": {
                      "name": "string.unquoted.cue-setting.webvtt"
                    }
                  }
                }
              ]
            }
          }
        },
        {
          "begin": "^[ \\t]*(?=\\S)",
          "end": "$",
          "name": "string.literal.webvtt",
          "patterns": [
            {
              "match": "&(?:[a-zA-Z]+|#[0-9]+);",
              "name": "constant.character.entity.webvtt"
            },
            {
              "match": "(</?)([a-zA-Z][a-zA-Z0-9]*)((?:\\.[a-zA-Z0-9-]+)*(?:[ \\t]+[^>]*)?)(>)",
              "captures": {
                "1": {
                  "name": "punctuation.definition.tag.begin.webvtt"
                },
                "2": {
                  "name": "entity.name.tag.webvtt"
                },
                "3": {
                  "name": "meta.attribute.webvtt"
                },
                "4": {
                  "name": "punctuation.definition.tag.end.webvtt"
                }
              }
            }
          ]
        }
      ]
    }
  }
}
